# BrandProof Environment Configuration

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# Database Configuration (Defaults to SQLite for local development; supports PostgreSQL)
# Example PostgreSQL: postgresql://postgres:password@localhost:5432/brandproof
DATABASE_URL=sqlite:///./brandproof.db

# Authentication Security (Generate a secure random string in production)
JWT_SECRET_KEY=brandproof-hackathon-round2-super-secure-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider API Keys (Optional - BrandProof features a deterministic rule engine that operates 100% offline)
# When set, the system uses structured JSON generation with Gemini or OpenAI
GEMINI_API_KEY=
OPENAI_API_KEY=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_TELEMETRY_DISABLED=1
