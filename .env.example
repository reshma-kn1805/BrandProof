# BrandProof Environment Configuration

# Application Environment (development, test, production)
ENV=development
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# Database Configuration (Defaults to SQLite for local development; supports PostgreSQL)
# Example PostgreSQL: postgresql://postgres:password@localhost:5432/brandproof
DATABASE_URL=sqlite:///./brandproof.db

# Authentication Security
# Required in production. In development, an ephemeral random key is generated automatically if omitted.
# Generate in production using: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider API Keys & Configurable Models
# (Optional - BrandProof features a deterministic rule engine that operates 100% offline)
# When set, the system uses structured JSON generation with Gemini or OpenAI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend Configuration & CORS
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
CORS_ORIGINS=https://reshma-kn1805.github.io,http://localhost:3000
NEXT_TELEMETRY_DISABLED=1
